# Copy to your n8n project as .env and fill in. Never commit the real file.

# Notion integration database ids (see setup_notion in README)
NOTION_DB_ID=
NOTION_EVAL_DB_ID=

# Telegram channel the digest is posted to, e.g. -1001234567890
TELEGRAM_EVAL_CHAT_ID=

# Bot token, used by the command listener to poll getUpdates
TELEGRAM_BOT_TOKEN=

# Long-lived Claude Code token: run `claude setup-token` in a terminal
CLAUDE_CODE_OAUTH_TOKEN=

# Optional: Artificial Analysis, for latency/cost sources (not yet wired up)
AA_API_KEY=
